{
  "name": "brifin-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run generate:api-development && npm run dev",
    "dev": "vite",
    "build": "npm run generate:api && vite build",
    "build:development": "npm run generate:api-development && vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "generate:pre": "node scripts/update-openapi-servers.mjs",
    "generate:api": "npm run generate:pre && npm run generate:api-docs && npm run generate:post",
    "generate:api-development": "npm run generate:pre -- --mode development && npm run generate:api-docs && npm run generate:post",
    "generate:post": "node ./tsNoCheckScript.cjs",
    "generate:api-docs": "openapi-generator-cli generate -i ./src/api-docs/api-docs.json -g typescript-fetch -o ./src/api/generated --additional-properties=useSingleRequestParameter=true,typescriptThreePlus=true,withInterfaces=true,enumPropertyNaming=UPPERCASE"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/lab": "^7.0.1-beta.20",
    "@mui/material": "^7.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "react-router-dom": "^7.11.0",
    "sass": "^1.97.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@openapitools/openapi-generator-cli": "^2.13.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.0"
  }
}
